{
  "manifest_version": 3,
  "name": "Lobby Sweeper",
  "version": "0.2.6",
  "description": "Paragon lobby sweeper: flags cases sitting in the wrong queue and raises SLA alerts (needs response, unassigned, PAA overdue) for the team's Paragon lobby.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lobby-sweeper@internal",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://paragon-eu.amazon.com/*",
    "https://smc-eu-dub.dub.proxy.amazon.com/*",
    "https://trans-logistics-eu.amazon.com/*",
    "https://amazongbr.sharepoint.com/*",
    "https://hooks.slack.com/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Lobby Sweeper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://paragon-eu.amazon.com/*"],
      "js": ["content/paragon-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://smc-eu-dub.dub.proxy.amazon.com/*"],
      "js": ["content/smc-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://trans-logistics-eu.amazon.com/fmc/*"],
      "js": ["content/fmc-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://amazongbr.sharepoint.com/sites/AmazonFreightOperations/*"],
      "js": ["content/sp-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
